+    private boolean compatibilityPrefixReady() {
+        return compatTmp.isDirectory() && compatSocketDir.isDirectory()
+                && new File(compatPrefix, "bin/xkbcomp").exists()
+                && new File(compatPrefix, "share/X11/xkb").exists();
+    }
+
+    private void prepareCompatibilityPrefix() throws IOException {
+        deleteRecursive(compatPrefix);
+        File compatBin = new File(compatPrefix, "bin");
+        File compatShareX11 = new File(compatPrefix, "share/X11");
+        File compatLibXorg = new File(compatPrefix, "lib/xorg");
+        mkdir(compatBin);
+        mkdir(compatShareX11);
+        mkdir(compatLibXorg);
+        mkdir(compatTmp);
+        mkdir(compatSocketDir);
+        symlink(xkbcomp, new File(compatBin, "xkbcomp"));
+        symlink(xkbRoot, new File(compatShareX11, "xkb"));
+        chmodBestEffort(compatTmp, 01777);
+        chmodBestEffort(compatSocketDir, 01777);
+    }
+
+    private void clearDisplayArtifacts(int display) throws IOException {
+        mkdir(compatTmp);
+        mkdir(compatSocketDir);
+        deleteIfPresent(new File(compatTmp, ".tX" + display + "-lock"));
+        deleteIfPresent(new File(compatTmp, ".X" + display + "-lock"));
+        deleteIfPresent(new File(compatSocketDir, "X" + display));
+        chmodBestEffort(compatTmp, 01777);
+        chmodBestEffort(compatSocketDir, 01777);
+    }
+
+    private static void deleteIfPresent(File f) throws IOException {
+        if ((f.exists() || Files.isSymbolicLink(f.toPath())) && !f.delete()) {
+            throw new IOException("Falha removendo artefato X11 anterior: " + f);
+        }
+    }
+
+    private static void chmodBestEffort(File f, int mode) {
+        try { Os.chmod(f.getAbsolutePath(), mode); } catch (Exception ignored) { }
+    }
+
