+TERMUX_PREFIX_BYTES = b"/data/data/com.termux/files/usr"
+CERBERUS_PREFIX_BYTES = b"/data/data/dev.cerberus.pc/xusr"
+if len(TERMUX_PREFIX_BYTES) != len(CERBERUS_PREFIX_BYTES):
+    raise RuntimeError("Cerberus compatibility prefix must preserve binary string length")
+
+
+def patched_host_bytes(path: Path) -> bytes:
+    data = path.read_bytes()
+    return data.replace(TERMUX_PREFIX_BYTES, CERBERUS_PREFIX_BYTES)
+
+
+def patched_host_copy(src: Path, dst: Path) -> None:
+    dst.write_bytes(patched_host_bytes(src))
+    shutil.copymode(src, dst)
+
+
