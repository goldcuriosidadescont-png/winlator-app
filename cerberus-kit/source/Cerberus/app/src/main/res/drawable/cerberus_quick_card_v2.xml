<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1A222B" android:endColor="#11171E" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#5B1B2D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#151B22" android:endColor="#0F141A" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2A333D" />
        </shape>
    </item>
</selector>
