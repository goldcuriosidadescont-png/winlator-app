<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/cerberus_component_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:src="@drawable/ic_cerberus_driver"
            android:tint="#FF1744"
            android:contentDescription="DXVK" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DXVK"
                android:textColor="#F7F9FB"
                android:textSize="11.5sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Direct3D 9/10/11 → Vulkan • Async / GPLAsync"
                android:textColor="#7E8995"
                android:textSize="8.5sp" />
        </LinearLayout>
    </LinearLayout>

    <Spinner
        android:tag="cerberus_spinner_dxvk"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/cerberus_input"
        android:paddingStart="9dp"
        android:paddingEnd="7dp"
        android:spinnerMode="dropdown" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="REPOS"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/cerberus_mini_button_red"
            android:clickable="true"
            android:focusable="true"
            android:onClick="cerberusAdrenoDXVK" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="INSTALADOS"
            android:textColor="#F7F9FB"
            android:textSize="7.5sp"
            android:textStyle="bold"
            android:background="@drawable/cerberus_mini_button_dark"
            android:clickable="true"
            android:focusable="true"
            android:onClick="cerberusAdrenoDXVKInstalled" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="ARQUIVO"
            android:textColor="#F7F9FB"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/cerberus_mini_button_dark"
            android:clickable="true"
            android:focusable="true"
            android:onClick="cerberusAdrenoDXVKFile" />
    </LinearLayout>
</LinearLayout>
