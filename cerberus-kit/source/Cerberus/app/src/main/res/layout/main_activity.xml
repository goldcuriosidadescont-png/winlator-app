<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/cerberus_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/cerberus_screen_bg">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:minHeight="58dp"
            android:elevation="0dp"
            android:background="@drawable/cerberus_toolbar_bg_v2"
            android:paddingEnd="8dp"
            app:contentInsetStartWithNavigation="6dp"
            app:title="CERBERUS WINLATOR"
            app:subtitle="PC GAMING NO SEU ANDROID"
            app:titleTextColor="#F7F9FB"
            app:subtitleTextColor="#89939E"
            app:titleMarginStart="7dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginStart="9dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/cerberus_hero_v2"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="13dp"
                android:alpha="0.22"
                android:contentDescription="Cerberus"
                android:scaleType="fitCenter"
                android:src="@drawable/cerberus_brand_mark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="104dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CERBERUS WINLATOR"
                    android:textColor="#FAFBFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.035" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SIMPLES • ESTÁVEL • OTIMIZADO"
                    android:textColor="#8F99A5"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.13" />

                <View
                    android:layout_width="52dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#FF1744" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="TRÊS CABEÇAS. UM SÓ PROPÓSITO."
                    android:textColor="#D7DCE2"
                    android:textSize="8sp"
                    android:letterSpacing="0.075" />
            </LinearLayout>

            <View
                android:layout_width="3dp"
                android:layout_height="47dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="9dp"
                android:rotation="32"
                android:background="#FF1744" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginStart="9dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="9dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/CerberusQuickGames"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:background="@drawable/cerberus_quick_card_selector"
                android:clickable="true"
                android:focusable="true"
                android:onClick="cerberusNavGames">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cerberus_games"
                    android:tint="#F2F5F8"
                    android:contentDescription="Jogos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="MEUS JOGOS"
                    android:textColor="#F2F5F8"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CerberusQuickContainers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:background="@drawable/cerberus_quick_card_selector"
                android:clickable="true"
                android:focusable="true"
                android:onClick="cerberusNavHome">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cerberus_container"
                    android:tint="#F2F5F8"
                    android:contentDescription="Containers" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="CONTAINERS"
                    android:textColor="#F2F5F8"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CerberusQuickExplore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:background="@drawable/cerberus_quick_card_selector"
                android:clickable="true"
                android:focusable="true"
                android:onClick="cerberusNavExplore">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cerberus_explore"
                    android:tint="#F2F5F8"
                    android:contentDescription="Explorar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="EXPLORAR"
                    android:textColor="#F2F5F8"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CerberusQuickTools"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:background="@drawable/cerberus_quick_card_selector"
                android:clickable="true"
                android:focusable="true"
                android:onClick="cerberusNavTweaks">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cerberus_tools"
                    android:tint="#FF1744"
                    android:contentDescription="Ferramentas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="CS-TWEAKS"
                    android:textColor="#F2F5F8"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="#FF1744" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="WINLATOR"
                android:textColor="#F7F9FB"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="CERBERUS EXPERIENCE"
                android:textColor="#5F6A75"
                android:textSize="7sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/CerberusContentHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/cerberus_content_surface_v2"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/FLFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

            <ScrollView
                android:id="@+id/CerberusExplorePanel"
                android:tag="cerberus_explore_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:background="#070A0D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXPLORAR"
                        android:textColor="#F7F9FB"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Recursos, componentes e ferramentas do Cerberus Winlator"
                        android:textColor="#8F99A5"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="54dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginBottom="11dp"
                        android:background="#FF1744" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="74dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/cerberus_feature_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="cerberusShowAdrenoTools">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_cerberus_driver"
                            android:tint="#FF1744"
                            android:contentDescription="Adreno Tools" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ADRENO TOOLS"
                                android:textColor="#F7F9FB"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Turnip via GitHub API, Box64, DXVK, VKD3D e WineD3D"
                                android:textColor="#8F99A5"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#FF1744"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/cerberus_feature_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="cerberusOpenOneUiReleases">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_cerberus_github"
                            android:tint="#F2F5F8"
                            android:contentDescription="Turnip OneUI" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TURNIP • GITHUB API"
                                android:textColor="#F7F9FB"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Lista repos e drivers dentro do app • download + instalação automática"
                                android:textColor="#7E8995"
                                android:textSize="8.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/cerberus_feature_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="cerberusOpenWinlatorComponents">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_cerberus_cloud"
                            android:tint="#FF1744"
                            android:contentDescription="Componentes GitHub" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REPOSITÓRIO DE COMPONENTES"
                                android:textColor="#F7F9FB"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Fonte GitHub usada pelo gerenciador de downloads"
                                android:textColor="#7E8995"
                                android:textSize="8.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/cerberus_feature_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="cerberusOpenDrawer">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_cerberus_tools"
                            android:tint="#AAB2BC"
                            android:contentDescription="Menu clássico" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MENU CLÁSSICO DO WINLATOR"
                                android:textColor="#F7F9FB"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Acesso direto ao drawer original"
                                android:textColor="#7E8995"
                                android:textSize="8.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/CerberusAdrenoPanel"
                android:tag="cerberus_adreno_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:background="#070A0D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:text="‹"
                            android:textColor="#FF1744"
                            android:textSize="30sp"
                            android:background="@drawable/cerberus_icon_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="cerberusAdrenoBack" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ADRENO TOOLS"
                                android:textColor="#F7F9FB"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GitHub Component Center"
                                android:textColor="#8F99A5"
                                android:textSize="8.5sp"
                                android:letterSpacing="0.08" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_cerberus_driver"
                            android:tint="#FF1744"
                            android:contentDescription="Adreno Tools" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:layout_marginBottom="10dp"
                        android:padding="10dp"
                        android:background="@drawable/cerberus_info_panel"
                        android:text="Drivers externos são baixados e instalados internamente pelo AdrenoTools. Na interface eles aparecem junto às versões Turnip em Container > Driver Gráfico > Turnip > Configuração > Versão. O bridge para o loader Android é automático e invisível."
                        android:textColor="#AAB2BC"
                        android:textSize="9sp"
                        android:lineSpacingExtra="2dp" />

                    <include layout="@layout/cerberus_component_turnip" />
                    <include layout="@layout/cerberus_component_adrenotools" />
                    <include layout="@layout/cerberus_component_box64" />
                    <include layout="@layout/cerberus_component_bionic_cpu" />
                    <include layout="@layout/cerberus_component_bionic_graphics" />
                    <include layout="@layout/cerberus_component_wineproton" />
                    <include layout="@layout/cerberus_component_dxvk" />
                    <include layout="@layout/cerberus_component_vkd3d" />
                    <include layout="@layout/cerberus_component_wined3d" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/cerberus_feature_card">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_cerberus_wine"
                            android:tint="#F2F5F8"
                            android:contentDescription="Wine Proton" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WINE / PROTON"
                                android:textColor="#F7F9FB"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Gerenciado pelo instalador de Wine do Winlator"
                                android:textColor="#7E8995"
                                android:textSize="8.5sp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="82dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="AJUSTES"
                            android:textColor="#F7F9FB"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/cerberus_button_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="cerberusOpenWineSettings" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:background="@drawable/cerberus_bottom_bar_v2"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/CerberusNavHome"
                android:tag="cerberus_nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/cerberus_bottom_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:onClick="cerberusNavHome">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_cerberus_home"
                    android:tint="@color/cerberus_nav_icon_tint"
                    android:contentDescription="Início" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:text="Início"
                    android:textColor="@color/cerberus_nav_text_tint"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:background="@drawable/cerberus_nav_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CerberusNavGames"
                android:tag="cerberus_nav_games"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/cerberus_bottom_item_selector"
                android:clickable="true"
